<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="006-add-category-and-fragility-to-packages" author="marcin">
        <addColumn tableName="packages">
            <column name="category" type="VARCHAR(50)" defaultValue="STANDARD">
                <constraints nullable="false"/>
            </column>

            <column name="fragility" type="VARCHAR(50)" defaultValue="STANDARD">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
