<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet
            id="004-create-inbox-events"
            author="marcin">

        <createTable tableName="inbox_events">

            <column
                    name="id"
                    type="UUID">
                <constraints
                        primaryKey="true"
                        nullable="false"/>
            </column>

            <column
                    name="event_id"
                    type="UUID">
                <constraints nullable="false"/>
            </column>

            <column
                    name="event_type"
                    type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>

            <column
                    name="received_at"
                    type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <addUniqueConstraint
                tableName="inbox_events"
                columnNames="event_id"
                constraintName="uk_inbox_events_event_id"/>

        <createIndex
                tableName="inbox_events"
                indexName="idx_inbox_events_received_at">

            <column name="received_at"/>

        </createIndex>

    </changeSet>

</databaseChangeLog>